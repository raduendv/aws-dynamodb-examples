              pm.expect(row.reservationId).to.be.a('string');
              pm.expect(row.paymentId).to.be.a('string');
              pm.expect(row.amount).to.be.a('number');
              pm.expect(row.status).to.be.a('string');
              pm.expect(row.createdAtUtc).to.be.a('string');
              pm.expect(row.createdAtUtc).to.match(/^\d{4}-\d{2}-\d{2}T/);
            });
          });
          pm.test('BatchGetReservationsResponse: missingReservationIds[]', function () {
            j.missingReservationIds.forEach(function (id, idx) {
              pm.expect(id, 'missingReservationIds[' + idx + ']').to.be.a('string');
            });
          });
        },
        assertReservationResponse: function (row, idx) {
          pm.expect(row, 'ReservationResponse[' + idx + ']').to.have.keys(['reservationId', 'paymentId', 'amount', 'status', 'createdAtUtc']);
          pm.expect(row.reservationId).to.be.a('string');
          pm.expect(row.paymentId).to.be.a('string');
          pm.expect(row.amount).to.be.a('number');
          pm.expect(row.status).to.be.a('string');
          pm.expect(row.createdAtUtc).to.be.a('string');
          pm.expect(row.createdAtUtc).to.match(/^\d{4}-\d{2}-\d{2}T/);
        },
        assertGetOutboundPaymentResponse: function () {
          var j = pm.response.json();
          pm.test('GetOutboundPaymentResponse (OpenAPI): top-level keys', function () {
            pm.expect(j).to.have.keys(['paymentId','state','correlationId','createdAtUtc','updatedAtUtc','debtorAccountId','creditorIban','creditorName','amount','currency','idempotencyKey','reasonCode','version','events']);
          });
          pm.test('GetOutboundPaymentResponse: scalar types', function () {
            pm.expect(j.paymentId).to.be.a('string');
            pm.expect(j.state).to.be.a('string');
            pm.expect(j.correlationId === null || typeof j.correlationId === 'string').to.eql(true);
            pm.expect(j.createdAtUtc).to.be.a('string');
            pm.expect(j.updatedAtUtc).to.be.a('string');
            pm.expect(j.debtorAccountId).to.be.a('string');
            pm.expect(j.creditorIban).to.be.a('string');
            pm.expect(j.creditorName).to.be.a('string');
            pm.expect(j.amount).to.be.a('number');
            pm.expect(j.currency).to.be.a('string');
            pm.expect(j.idempotencyKey).to.be.a('string');
            pm.expect(j.reasonCode === null || typeof j.reasonCode === 'string').to.eql(true);
            pm.expect(j.version).to.be.a('number');
            pm.expect(j.events).to.be.an('array');
          });
          pm.test('GetOutboundPaymentResponse: events[] (OpenAPI)', function () {
            j.events.forEach(function (ev, evIdx) {
              pm.expect(ev, 'events[' + evIdx + ']').to.have.keys(['eventKey', 'eventType', 'reasonCode', 'correlationId']);
              pm.expect(ev.eventKey).to.be.a('string');
              pm.expect(ev.eventType).to.be.a('string');
              pm.expect(ev.reasonCode === null || typeof ev.reasonCode === 'string').to.eql(true);
              pm.expect(ev.correlationId === null || typeof ev.correlationId === 'string').to.eql(true);
            });
          });
          return j;
        },
        assertMerchantPaymentsPage: function (page, opts) {
          opts = opts || {};
          pm.test('MerchantPaymentsPage (OpenAPI): envelope', function () {
            pm.expect(page).to.be.an('object');
            pm.expect(page).to.include.keys(['items']);
            pm.expect(page.items).to.be.an('array');
            if (Object.prototype.hasOwnProperty.call(page, 'nextToken') && page.nextToken != null) {
              pm.expect(page.nextToken).to.be.a('string');
            }
          });
          var items = page.items;
          pm.test('MerchantPaymentsPage: optional item count bounds', function () {
            if (typeof opts.maxLength === 'number') { pm.expect(items.length).to.be.at.most(opts.maxLength); }
            if (typeof opts.minLength === 'number') { pm.expect(items.length).to.be.at.least(opts.minLength); }
          });
          pm.test('MerchantPaymentsPage: items[] (OpenAPI)', function () {
            items.forEach(function (p, idx) {
              pm.expect(p, 'items[' + idx + ']').to.have.keys(['paymentId','state','version','merchantId','correlationId','amount','currency','createdAtUtc','updatedAtUtc','reasonCode']);
              pm.expect(p.paymentId).to.be.a('string');
              pm.expect(p.state).to.be.a('string');
              pm.expect(p.version).to.be.a('number');
              pm.expect(p.merchantId).to.be.a('string');
              pm.expect(p.correlationId === null || typeof p.correlationId === 'string').to.eql(true);
              pm.expect(p.amount).to.be.a('number');
              pm.expect(p.currency).to.be.a('string');
              pm.expect(p.createdAtUtc).to.be.a('string');
              pm.expect(p.createdAtUtc).to.match(/^\d{4}-\d{2}-\d{2}T/);
              pm.expect(p.updatedAtUtc).to.be.a('string');
              pm.expect(p.updatedAtUtc).to.match(/^\d{4}-\d{2}-\d{2}T/);
              pm.expect(p.reasonCode === null || typeof p.reasonCode === 'string').to.eql(true);
            });
          });
        },
        assertGetAccountResponse: function () {
          var j = pm.response.json();
          pm.test('GetAccountResponse (OpenAPI)', function () {
            pm.expect(j).to.have.keys(['accountId','status','currency','currentBalance','availableBalance','reservations']);
            pm.expect(j.accountId).to.be.a('string');
            pm.expect(j.status).to.be.a('string');
            pm.expect(j.currency).to.be.a('string');
            pm.expect(j.currentBalance).to.be.a('number');
            pm.expect(j.availableBalance).to.be.a('number');
            pm.expect(j.reservations).to.be.an('array');
          });
          pm.test('GetAccountResponse: reservations[] (OpenAPI)', function () {
            j.reservations.forEach(function (row, idx) { pm.__postmanOpenApiStrict.assertReservationResponse(row, idx); });
          });
          return j;
        }
      };
    }
    // --- end helpers ---
    pm.test('400', () => pm.response.to.have.status(400));
    pm.__postmanOpenApiStrict.assertErrorWithOptionalCode('VALIDATION_ERROR');
%}