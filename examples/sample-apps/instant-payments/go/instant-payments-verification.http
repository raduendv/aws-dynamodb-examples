    // ── Ported Postman→ijhttp compatibility shim (defined once; reused via client.global) ──
    client.global.set("__IP_BOOT__", `(function () {
  function typeOf(v) {
    if (v === null) return 'null';
    if (Array.isArray(v)) return 'array';
    return typeof v;
  }
  function deepEqual(a, b) {
    if (a === b) return true;
    if (typeOf(a) !== typeOf(b)) return false;
    var t = typeOf(a);
    if (t === 'array') {
      if (a.length !== b.length) return false;
      for (var i = 0; i < a.length; i++) { if (!deepEqual(a[i], b[i])) return false; }
      return true;
    }
    if (t === 'object') {
      var ka = Object.keys(a), kb = Object.keys(b);
      if (ka.length !== kb.length) return false;
      for (var j = 0; j < ka.length; j++) {
        var k = ka[j];
        if (kb.indexOf(k) === -1) return false;
        if (!deepEqual(a[k], b[k])) return false;
      }
      return true;
    }
    return false;
  }
  function makeExpect(actual, message) {
    var negated = false;
    function prefix(m) { return message ? (message + ': ' + m) : m; }
    function ok(cond, msg) {
      var pass = negated ? !cond : cond;
      if (!pass) { client.assert(false, prefix((negated ? '[negated] ' : '') + msg)); }
    }
    var api = {};
    api.a = function (t) { ok(typeOf(actual) === String(t).toLowerCase(), 'expected type ' + t + ' but was ' + typeOf(actual)); return api; };
    api.an = api.a;
    api.eql = function (e) { ok(deepEqual(actual, e), 'expected ' + JSON.stringify(actual) + ' to deep-equal ' + JSON.stringify(e)); return api; };
    api.equal = api.eql;
    api.match = function (re) { ok(re.test(String(actual)), 'expected "' + actual + '" to match ' + re); return api; };
    api.oneOf = function (arr) { ok(arr.indexOf(actual) !== -1, 'expected ' + JSON.stringify(actual) + ' to be one of ' + JSON.stringify(arr)); return api; };
    api.property = function (k) { ok(actual != null && Object.prototype.hasOwnProperty.call(actual, k), 'expected property "' + k + '"'); return api; };
    api.keys = function (list) {
      if (!Array.isArray(list)) { list = Array.prototype.slice.call(arguments); }
      var actualKeys = actual != null ? Object.keys(actual) : [];
      var sameLen = actualKeys.length === list.length;
      var allIn = list.every(function (k) { return actualKeys.indexOf(k) !== -1; });
      ok(sameLen && allIn, 'expected exact keys ' + JSON.stringify(list) + ' but had ' + JSON.stringify(actualKeys));
      return api;
    };
    api.least = function (n) { ok(actual >= n, 'expected ' + actual + ' to be >= ' + n); return api; };
    api.most = function (n) { ok(actual <= n, 'expected ' + actual + ' to be <= ' + n); return api; };
    Object.defineProperty(api, 'empty', { get: function () {
      var empty = actual != null && ((Array.isArray(actual) || typeof actual === 'string') ? actual.length === 0 : Object.keys(actual).length === 0);
      ok(empty, 'expected value to be empty');
      return api;
    } });
    function includeFn(x) {
      if (typeof actual === 'string') { ok(actual.indexOf(x) !== -1, 'expected "' + actual + '" to include "' + x + '"'); }
      else if (Array.isArray(actual)) { ok(actual.indexOf(x) !== -1, 'expected array to include ' + JSON.stringify(x)); }
      else { ok(false, 'include() on unsupported type ' + typeOf(actual)); }
      return api;
    }
    includeFn.keys = function (list) {
      if (!Array.isArray(list)) { list = Array.prototype.slice.call(arguments); }
      var actualKeys = actual != null ? Object.keys(actual) : [];
      var missing = list.filter(function (k) { return actualKeys.indexOf(k) === -1; });
      ok(missing.length === 0, 'expected keys to include ' + JSON.stringify(list) + ' but missing ' + JSON.stringify(missing));
      return api;
    };
    api.include = includeFn;
    Object.defineProperty(api, 'to', { get: function () { return api; } });
    Object.defineProperty(api, 'be', { get: function () { return api; } });
    Object.defineProperty(api, 'been', { get: function () { return api; } });
    Object.defineProperty(api, 'is', { get: function () { return api; } });
    Object.defineProperty(api, 'that', { get: function () { return api; } });
    Object.defineProperty(api, 'have', { get: function () { return api; } });
    Object.defineProperty(api, 'has', { get: function () { return api; } });
    Object.defineProperty(api, 'at', { get: function () { return api; } });
    Object.defineProperty(api, 'and', { get: function () { return api; } });
    Object.defineProperty(api, 'not', { get: function () { negated = !negated; return api; } });
    return api;
  }
  var pm = {
    test: function (name, fn) { client.test(name, function () { fn(); }); },
    expect: function (actual, message) { return makeExpect(actual, message); },
    response: {
      json: function () {
        var body = (typeof response.body === 'string') ? JSON.parse(response.body) : response.body;
        return JSON.parse(JSON.stringify(body));
      },
      to: { have: { status: function (n) { client.assert(response.status === n, 'expected HTTP status ' + n + ' but got ' + response.status); } } },
      headers: { get: function (name) { var v = response.headers.valueOf(name); return (v === undefined ? null : v); } }
    },
    collectionVariables: {
      set: function (k, v) {
        var s = (v === undefined || v === null) ? '' : (typeof v === 'string' ? v : String(v));
        client.global.set(k, s);
        try { if (typeof request !== 'undefined' && request.variables && request.variables.set) { request.variables.set(k, s); } } catch (e) {}
      },
      get: function (k) { var v = client.global.get(k); return (v === undefined ? null : v); }
    },
    environment: {
      set: function (k, v) { pm.collectionVariables.set(k, v); },
      get: function (k) { return pm.collectionVariables.get(k); }
    },
    variables: {
      set: function (k, v) { pm.collectionVariables.set(k, v); },
      get: function (k) { return pm.collectionVariables.get(k); }
    }
  };
  return pm;
})()`);
