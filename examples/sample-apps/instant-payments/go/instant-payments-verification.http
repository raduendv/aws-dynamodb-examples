GET {{baseUrl}}/api-docs

> {%
    client.test('200', function () {
      client.assert(response.status === 200, 'expected HTTP status 200 but got ' + response.status);
    });
    var doc = typeof response.body === 'string' ? JSON.parse(response.body) : response.body;
    client.test('Published OpenAPI discovery document', function () {
      client.assert(Object.prototype.hasOwnProperty.call(doc, 'openapi'), 'expected openapi property');
      client.assert(Object.prototype.hasOwnProperty.call(doc, 'info'), 'expected info property');
      client.assert(Object.prototype.hasOwnProperty.call(doc, 'paths'), 'expected paths property');
      client.assert(typeof doc.openapi === 'string', 'expected openapi to be a string');
      client.assert(doc.info !== null && typeof doc.info === 'object', 'expected info to be an object');
      client.assert(doc.paths !== null && typeof doc.paths === 'object', 'expected paths to be an object');
    });
%}

