GET {{baseUrl}}/actuator/health

> {%
    var pm = eval(client.global.get("__IP_BOOT__"));
    pm.test('200', () => pm.response.to.have.status(200));
    var j = pm.response.json();
    pm.test('Actuator health JSON shape', function () {
      pm.expect(j).to.have.keys(['status']);
      pm.expect(j.status).to.be.a('string');
    });
    pm.expect(j.status).to.eql('healthy');
