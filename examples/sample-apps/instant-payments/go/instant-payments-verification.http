# group: Story 5 - Batch get reservations for an account
# @name Step 5.19 - OpenAPI: batch-get 400 documents INVALID_BATCH_GET_RESERVATIONS_REQUEST

GET {{baseUrl}}/api-docs

> {%
    var pm = eval(client.global.get("__IP_BOOT__"));
    pm.test('200', () => pm.response.to.have.status(200));
    var doc = pm.response.json();
    pm.test('OpenAPI batch-get path present', function () {
      pm.expect(doc.paths).to.have.property('/api/v1/accounts/{accountId}/batch-get-reservations');
    });
    pm.test('batch-get POST 400 contract mentions INVALID_BATCH_GET_RESERVATIONS_REQUEST', function () {
      var op = doc.paths['/api/v1/accounts/{accountId}/batch-get-reservations'].post;
      var merged = (op.description || '') + ' ' + (op.responses['400'].description || '');
      pm.expect(merged).to.include('INVALID_BATCH_GET_RESERVATIONS_REQUEST');
    });
%}

